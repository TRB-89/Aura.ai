# ==============================================================================
# PROJECT AURA — Configuration Template (.env.example)
# Copy this file to .env and configure your personal settings.
# NEVER commit your actual .env file or real API keys to version control.
# ==============================================================================

# Google Gemini API Key (Required for conversational AI and tool intent routing)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Backend Host & Port (Runs locally on 127.0.0.1 only)
AURA_HOST=127.0.0.1
AURA_PORT=49200

# Backend Authentication Token (Auto-generated by Electron at launch)
AURA_TOKEN=generate_random_token_here

# Application Storage Directory (Defaults to %LOCALAPPDATA%\AURA)
# AURA_DATA_DIR=C:\Users\<YourUser>\AppData\Local\AURA
# AURA_DB_PATH=C:\Users\<YourUser>\AppData\Local\AURA\aura.db

# Voice & Speech Configuration
AURA_VOICE_RATE=180
AURA_VOICE_VOLUME=1.0
AURA_WAKE_WORD_ENABLED=false
AURA_MICROPHONE_DEVICE=default

# Security & Lock Settings
AURA_AUTO_LOCK_MINUTES=15
AURA_MAX_FAILED_ATTEMPTS=5
AURA_LOCKOUT_DURATION_SECONDS=300
